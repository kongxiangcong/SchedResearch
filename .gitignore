# Python-generated cache files
__pycache__/
*.py[cod]

# R7 source-retrieval caches; authoritative extracted files live beside them.
/r7/sources/kernel_access/riallto_repo/
/r7/sources/kernel_access/ryzenai_repo/
/r7/sources/kernel_access/dynamicdispatch_repo/

# Generated experimental result payloads.
# Keep raw traces, samples, arrays, compressed outputs, and other unreviewed
# payloads local. The explicit allowlist below contains reviewed compact
# figures and conclusion artifacts; large experiment files remain ignored.
/experiments/results/**
!/experiments/results/**/
/r3/figures/**
!/r3/figures/**/
/r4/figures/**
!/r4/figures/**/
/r4/results/**
!/r4/results/**/
/r5/results/**

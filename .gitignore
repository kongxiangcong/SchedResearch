/r9/results/**
!/r9/results/**/
/r10/results/**
!/r10/results/**/
/r10/causal_results/**
!/r10/causal_results/**/
/r11/results/**
!/r11/results/**/
/r11/numerical_data/**
!/r11/numerical_data/**/

